{
    "name": "jeffshaikh/performance-toolkit",
    "description": "WordPress performance optimization toolkit",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "version": "1.0.0",
    "scripts": {
        "lint": "find includes -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test:smoke": "php tests/smoke-settings.php"
    },
    "require": {
        "illuminate/view": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PerformanceToolkit\\": "includes/"
        }
    },
    "authors": [
        {
            "name": "Jeff Shaikh",
            "email": "jeff@digitalcanvas.com"
        }
    ],
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.3",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpcsstandards/phpcsextra": "^1.5",
        "wp-cli/dist-archive-command": "^3.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
