node_modules/
.wp-env/

# Dev-only Composer packages (require-dev).
vendor/squizlabs/
vendor/wp-coding-standards/
vendor/phpcompatibility/
vendor/phpcsstandards/
vendor/wp-cli/
vendor/dealerdirect/
vendor/inmarelibero/
vendor/bin/

# Build tooling binaries — not needed at runtime.
bin/

# VCS and local metadata.
.git/
.github/
.gitignore
.gitmodules
.distignore
.DS_Store
.idea/

# Build/test tooling (not needed at runtime).
phpcs.xml.dist
phpcs.log
tests/
docs/
references/

# Frontend build sources/config not required in the shipped package.
src/css/
src/js/
package.json
package-lock.json
tailwind.config.js
vite.config.js

# composer.json documents what's declared/bundled in includes/Vendor and is
# required by WordPress.org's Plugin Check (missing_composer_json_file) when
# a plugin ships Composer-managed dependencies. composer.lock stays excluded —
# it's a large generated file already tracked in the public GitHub repo.
composer.lock

# Project docs not used by WordPress runtime.
README.md
.dev/

# WordPress.org assets metadata folder.
.wordpress-org/

# Local cache/artifacts.
wp-cache/
dist-builds/

# WordPress.org disallows hidden files anywhere in a submitted package.
# Bundled third-party dependencies (e.g. includes/Vendor/**) ship their own
# dotfiles (.editorconfig, .phpstorm.meta.php, .deepsource.toml, etc.); this
# catches those and any other hidden file, not just the specific names above.
.*

# Carbon's full locale/translation data set (800+ files, ~3.4MB). This plugin
# never calls Carbon's localization APIs (no setLocale/diffForHumans usage),
# so it's unused dead weight — and it ships a handful of "@variant" filenames
# (e.g. be_BY@latin.php) that WordPress.org's plugin checker rejects.
includes/Vendor/nesbot/carbon/src/Carbon/Lang/

# Dead weight bundled inside third-party dependencies: test doubles/helpers
# meant for consumers' own PHPUnit suites (never loaded by this plugin), and
# dev-tooling integration classes (PHPStan, a standalone CLI, a Laravel
# service provider) that are unreachable outside those specific contexts.
Test/
Testing/
includes/Vendor/nesbot/carbon/src/Carbon/PHPStan/
includes/Vendor/nesbot/carbon/src/Carbon/Cli/
includes/Vendor/nesbot/carbon/src/Carbon/Laravel/
includes/Vendor/nesbot/carbon/extension.neon

# Changelogs from bundled dependencies (READMEs are already covered above).
CHANGELOG.md
