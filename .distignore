# Frontend build sources/config not required in the shipped package.
src/css/
src/js/
package.json
package-lock.json
tailwind.config.js
vite.config.js

# Composer manifests are not required when shipping vendor.
composer.json
composer.lock

# Project docs not used by WordPress runtime.
README.md
.dev/

# WordPress.org assets metadata folder.
.wordpress-org/

# Local cache/artifacts.
wp-cache/

# WordPress.org disallows hidden files anywhere in a submitted package.
# Bundled third-party dependencies (e.g. includes/Vendor/**) ship their own
# dotfiles (.editorconfig, .phpstorm.meta.php, .deepsource.toml, etc.); this
# catches those and any other hidden file, not just the specific names above.
.*

# Carbon's full locale/translation data set (800+ files, ~3.4MB). This plugin
# never calls Carbon's localization APIs (no setLocale/diffForHumans usage),
# so it's unused dead weight — and it ships a handful of "@variant" filenames
# (e.g. be_BY@latin.php) that WordPress.org's plugin checker rejects.
includes/Vendor/nesbot/carbon/src/Carbon/Lang/
